{
  "expo": {
    "name": "Seasonal Cards",
    "slug": "greetings-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/greetings-icon.png",
    "scheme": "greetingsmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.greetingsmobile.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E8",
        "foregroundImage": "./assets/images/greetings-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.greetingsmobile.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E8",
          "image": "./assets/images/greetings-splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Seasonal Cards to use a photo in your greeting.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
