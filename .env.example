MONGODB_URI=mongodb://127.0.0.1:27017/greetings?replicaSet=rs0
APP_BASE_URL=http://localhost:3000
# Relative to apps/web. Keep web and worker in the same directory.
LOCAL_MEDIA_DIR=./.media
# Configure all three for account flows and Clerk webhook verification.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Polar billing. Keep sandbox while configuring and testing.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# JSON: [{"id":"single","productId":"<Polar product UUID>","credits":1}]
# Prices and names are fetched from the corresponding Polar one-time product.
POLAR_PACKS=[]
# Both are required before checkout can be enabled.
BILLING_SELLER_NAME=
SUPPORT_EMAIL=
# Optional. Without a key, the message writer returns curated suggestions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
